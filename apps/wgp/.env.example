# Copy to .env.local. NEXT_PUBLIC_* values are shipped to the browser; the rest stay on
# your machine.

# Where "Play now" on the landing page goes. Defaults to /play.
# NEXT_PUBLIC_PLAY_URL=/play

# Shown in the site footer when set.
# NEXT_PUBLIC_REPO_URL=https://github.com/71Labs/WithGreatPower

# Used only by scripts/audio to generate sound effects, music and voices. Never exposed
# to the browser and never committed.
ELEVEN_LABS_API_KEY=

# --- Server (never shipped to the browser) ---------------------------------------
# Neon pooled Postgres URL. Leave unset locally to use PGlite in ./.data/pglite;
# production refuses to start without it.
# DATABASE_URL=postgres://…
# PGLITE_DIR=./.data/pglite

# Secrets, at least 16 characters each; required in production.
# SEED_SECRET=      # signs the seed of every ranked run
# AUTH_SECRET=      # keys session hashes
# CRON_SECRET=      # Vercel Cron sends it as "Authorization: Bearer …" to /api/cron/mint (every minute) and /api/cron/sweep (every 10 minutes); see vercel.json

# Local only: lets /api/auth/dev create a test player. Ignored in production.
# ALLOW_DEV_AUTH=1

# --- NEAR (testnet first) ------------------------------------------------------
NEAR_NETWORK=testnet
WGP_CONTRACT_ID=game.wgp.testnet
# NEAR_RPC_URLS=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org

# Creates player accounts (<handle>.wgp.testnet) with the player's key and a game-only session key.
FACTORY_ACCOUNT_ID=wgp.testnet
FACTORY_PRIVATE_KEY=
# FACTORY_INITIAL_BALANCE=0

# Pays gas for players' game actions (meta-transactions). 4–8 comma-separated full-access keys.
RELAYER_ACCOUNT_ID=relayer.wgp.testnet
RELAYER_PRIVATE_KEYS=
# RELAYER_DAILY_TGAS=200000
# RELAYER_MIN_BALANCE_NEAR=1

# Mints verified run rewards and records seasons. Prefer a function-call key on the game contract.
OPERATOR_ACCOUNT_ID=operator.wgp.testnet
OPERATOR_PRIVATE_KEY=
# NEAR_DAILY_ACCOUNTS=500

# NEAR Auth: the shared testnet dev client is used unless set. Mainnet needs an approved client id.
# NEAR_AUTH_CLIENT_ID=
# ALLOW_NEAR_AUTH_LAB=1

# --- Google sign-in through Privy (docs/ARCHITECTURE.md §5) --------------------------
# The Privy app (dashboard → App settings). The id is public; the secret stays on the
# server and verifies access tokens and reads users from Privy's API.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the server may read the app id from here instead of NEXT_PUBLIC_PRIVY_APP_ID.
# PRIVY_APP_ID=
# Optional: the dashboard's JWT verification key (PEM), to skip fetching Privy's JWKS.
# PRIVY_VERIFICATION_KEY=
# Which service "Continue with Google" uses: privy | near-auth. Unset: privy when
# NEXT_PUBLIC_PRIVY_APP_ID is set, else near-auth.
# NEXT_PUBLIC_GOOGLE_SIGN_IN=privy

NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_WGP_CONTRACT_ID=game.wgp.testnet
# NEXT_PUBLIC_WGP_PARENT_ACCOUNT_ID=wgp.testnet
# NEXT_PUBLIC_NEAR_RPC_URLS=
# NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=
