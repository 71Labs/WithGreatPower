-/// The current state from raw state bytes in either layout. Borsh refuses trailing or
+/// The first four bytes of a v3 state. v1 and v2 start with the owner id's length (at most
+/// 64), so they can never be mistaken for it.
+const LAYOUT_V3: u32 = 0x5747_5003;
+/// Where the v3-only roots (token index, metadata) wait for an upgrade back to v3.
+const V3_TAIL_KEY: &[u8] = b"V3TAIL";
+
+/// v3's market rules, field for field.
