+
+/// A v3 root state up to and including the market. The token index and the metadata root
+/// follow it.
+#[near(serializers = [borsh])]
+#[allow(dead_code)]
+struct WgpV3Head {
+    /// `LAYOUT_V3`, checked before this is parsed.
+    _layout: u32,
+    owner_id: AccountId,
+    operators: IterableSet<AccountId>,
+    paused: bool,
+    items: Vec<String>,
+    suits: Vec<SuitRule>,
+    starter_unlock_level: u32,
+    players: LookupMap<AccountId, Player>,
+    supply: LookupMap<TokenId, u128>,
+    seasons: LookupMap<String, Season>,
+    market: MarketV3,
+}
+
+/// A v3 state back in the v2 layout. Every player, pool, listing and season stays where it
+/// is; the live rules carry over; the investing rules are dropped.
+fn from_v3(bytes: &[u8]) -> Wgp {
+    let mut rest = bytes;
+    let v3 = WgpV3Head::deserialize(&mut rest)
+        .unwrap_or_else(|_| env::panic_str("The v3 contract state doesn't parse"));
+    for p in &v3.market.pools {
+        if p.invested.0 != 0 || p.rewards.0 != 0 {
+            env::panic_str(&format!(
+                "{} Bits are invested in {}: send the stakes home (market_refund) before rolling back",
+                p.invested.0, p.item
+            ));
+        }
+    }
+    env::storage_write(V3_TAIL_KEY, rest);
+    let p = v3.market.params;
+    Wgp {
+        owner_id: v3.owner_id,
+        operators: v3.operators,
+        paused: v3.paused,
+        items: v3.items,
+        suits: v3.suits,
+        starter_unlock_level: v3.starter_unlock_level,
+        players: v3.players,
+        supply: v3.supply,
+        seasons: v3.seasons,
+        market: Market {
+            params: MarketParams {
+                open: p.open,
+                fee_bps: p.fee_bps,
+                floor_bps: p.floor_bps,
+                ceiling_bps: p.ceiling_bps,
+                max_amount: p.max_amount,
+                max_open_listings: p.max_open_listings,
+                max_listings: p.max_listings,
+                daily_trades: p.daily_trades,
+                daily_listings: p.daily_listings,
+                daily_fills: p.daily_fills,
+                daily_fill_bits: p.daily_fill_bits,
+                craft_bits: p.craft_bits,
+            },
+            pools: v3
+                .market
+                .pools
+                .into_iter()
+                .map(|p| Pool {
+                    item: p.item,
+                    virtual_bits: p.virtual_bits,
+                    virtual_items: p.virtual_items,
+                    bits: p.bits,
+                    stock: p.stock,
+                    escrow: p.escrow,
+                })
+                .collect(),
+            listings: v3.market.listings,
+            next_listing_id: v3.market.next_listing_id,
+            accounts: v3.market.accounts,
+        },
+    }
+}
