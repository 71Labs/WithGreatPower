{
  "name": "with-great-power",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter wgp dev",
    "build": "pnpm --filter wgp build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "verify": "pnpm --filter wgp exec tsx ../../scripts/verify-run.ts",
    "stats": "node scripts/stats.mjs",
    "evidence": "node scripts/evidence.mjs"
  }
}
