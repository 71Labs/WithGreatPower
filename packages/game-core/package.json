{
  "name": "@wgp/game-core",
  "version": "0.1.0",
  "private": true,
  "description": "With Great Power's deterministic rules: the progression reducer, content data and (soon) the 3D sim, shared by the browser and the server verifier.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/rules/types.ts",
    "./data": "./src/rules/data.ts",
    "./engine": "./src/rules/engine.ts",
    "./cast": "./src/rules/cast.ts",
    "./content": "./src/rules/content.ts",
    "./sim3d/contract": "./src/sim3d/contract.ts",
    "./sim3d/constants": "./src/sim3d/constants.ts",
    "./sim3d": "./src/sim3d/index.ts",
    "./input": "./src/input/index.ts",
    "./replay": "./src/replay.ts",
    "./score": "./src/score.ts",
    "./hash": "./src/hash.ts",
    "./bridge3d": "./src/bridge3d.ts",
    "./golden": "./src/golden.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3"
  }
}
